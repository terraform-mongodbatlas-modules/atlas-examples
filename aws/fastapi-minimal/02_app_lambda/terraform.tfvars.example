# Paste from 01_infra outputs when app_tfvars writer is disabled (app_tfvars = "").
# Prefer the generated infra.auto.tfvars handoff.

aws_region                   = "us-east-1"
private_subnet_ids           = ["subnet-aaa", "subnet-bbb"]
lambda_security_group_id     = "sg-xxx"
lambda_execution_role_arn    = "arn:aws:iam::123456789012:role/fastapi-minimal-lambda-exec"
mongo_private_connection_string = "mongodb+srv://pl-0-us-east-1.xxxxx.mongodb.net"

# Optional overrides:
# name_prefix        = "fastapi-minimal"
# image_tag          = "0.0.1"
# app_database_name  = "test"
# ecr_repository_url = "123456789012.dkr.ecr.us-east-1.amazonaws.com/my-existing-repo"
