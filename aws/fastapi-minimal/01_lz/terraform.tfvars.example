atlas_org_id  = "<YOUR_ATLAS_ORG_ID>"
cluster_name  = "fastapi-minimal"

# # Public debug (public internet + SCRAM). Remove after testing.
# public_debug_access = {
#   ip_address = "1.2.3.4"  # your public IP; curl -fsS https://ifconfig.me
#   # username      = "debug"
#   # password      = "..."      # omit to auto-generate
#   # database_name = "test"     # default: readWrite on test
#   # role_name     = "readWrite"
# }
#
# # Full read/write on all databases (broader than the default test grant):
# public_debug_access = {
#   ip_address    = "1.2.3.4"
#   database_name = "admin"
#   role_name     = "readWriteAnyDatabase"
# }

# Optional overrides:
# default_resource_name_prefix = "fastapi-minimal"  # Atlas project + AWS resource names
# regions = [{ name = "us-east-1" }]
# tags = { Example = "aws-fastapi-minimal" }
#
# # Cheap personal lab (before first apply):
# cluster_type = "REPLICASET"
# # shard_count is ignored for REPLICASET
# # Pin compute (disk GB still auto-scales):
# manual_scaling = { instance_size = "M10" }
#
# # Atlas AWS integrations (omit for production defaults: encryption + log + backup on)
# # Lab (no CMK):
# atlas_integrations = { encryption = { enabled = false } }
# # Disable encryption + log + backup (PrivateLink still on):
# atlas_integrations = {
#   encryption      = { enabled = false }
#   log_integration = { enabled = false }
#   backup_export   = { enabled = false }
# }
# # Other patterns (BYO KMS, skip KMS PE, s3_force_destroy): see README FAQ.
#
# # --- AWS Lambda (optional) ---
# ecr_repositories = {
#   api = {
#     name                 = "fastapi-minimal-api"
#     image_tag_mutability = "IMMUTABLE"  # default; use MUTABLE only to overwrite tags
#     scan_on_push         = true
#     lifecycle_keep_count = 10  # 0 disables lifecycle policy
#     # region = "us-west-2"     # omit to default to regions[0]
#     # force_delete = false    # block destroy while images remain
#   }
# }
#
# lambda_apps = {
#   api = {
#     ecr_key     = "api"
#     roles       = [{ database_name = "test" }]
#     tfvars_path = "../02_app_lambda/infra.auto.tfvars"
#     # secret = { name = "fastapi-minimal-app" }  # null-gate; omit name to derive <app>-app
#   }
# }
#
# # --- Amazon ECS (optional) ---
# ecr_repositories = { api = {} }
#
# ecs_apps = {
#   api = {
#     ecr_key     = "api"
#     roles       = [{ database_name = "test" }]
#     tfvars_path = "../02_app_ecs/infra.auto.tfvars"
#     # secret = { name = "fastapi-minimal-ecs-app" }
#   }
# }
#
