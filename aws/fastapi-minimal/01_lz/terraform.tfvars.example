atlas_org_id = "<YOUR_ATLAS_ORG_ID>"

# Optional overrides:
# regions = [{ name = "us-east-1" }]
# name_prefix = "fastapi-minimal"
# tags = { Example = "aws-fastapi-minimal" }
# s3_force_destroy = true  # false retains log/backup bucket objects on destroy
#
# # Cheap personal lab (before first apply):
# cluster_type = "REPLICASET"
# # shard_count is ignored for REPLICASET
# # Pin compute (disk GB still auto-scales):
# manual_scaling = { instance_size = "M10" }
#
# # ECR is independent of lambda_apps (survives Lambda -> ECS compute changes):
# ecr_repositories = {
#   api = {
#     name                 = "fastapi-minimal-api"
#     image_tag_mutability = "IMMUTABLE"  # default; use MUTABLE only to overwrite tags
#     scan_on_push         = true
#     lifecycle_keep_count = 10  # 0 disables lifecycle policy
#     # region = "us-west-2"     # omit to default to regions[0]
#     # force_delete = false    # block destroy while images remain
#   }
# }
#
