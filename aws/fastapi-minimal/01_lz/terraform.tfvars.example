# }
#
# Then in 02_app_ecs/terraform.tfvars: handoff_secret_name = "hybridrag-app", image_tag = "0.0.1"
# Build: just build-push-backend "$(terraform -chdir=01_lz output -json ecr_repositories | jq -r '.hybridrag')"
# See docs/hybridrag-backend.md.
