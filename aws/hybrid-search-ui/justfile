default:
    @just --list

seed_dir := justfile_directory() + "/scripts"

# ECR login, build linux/arm64 UI image from example Dockerfile, tag, and push.
build-push repo_url tag="0.0.1":
    #!/usr/bin/env bash
    set -euo pipefail
    repo_url="{{repo_url}}"
    region="$(echo "${repo_url}" | cut -d. -f4)"
    aws ecr get-login-password --region "${region}" \
      | docker login --username AWS --password-stdin "${repo_url%/*}"
    image_uri="${repo_url}:{{tag}}"
    docker build --platform linux/arm64 \
      -f "{{justfile_directory()}}/Dockerfile" \
      -t "${image_uri}" \
      "{{justfile_directory()}}"
    docker push "${image_uri}"
    echo "Pushed ${image_uri}"

# Write a raw LLM API key to Secrets Manager. Paste the printed name into lz tfvars as llm_secret_name.
create-llm-secret name="hybrid-search-ui-llm" region="us-east-1":
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Supported providers. Set llm_env_name in lz tfvars to match the key:" >&2
    echo "  ANTHROPIC_API_KEY  optional llm_env.ANTHROPIC_MODEL" >&2
    echo "  OPENAI_API_KEY     optional llm_env.OPENAI_MODEL, OPENAI_BASE_URL" >&2
    echo "  GEMINI_API_KEY     optional llm_env.GEMINI_MODEL" >&2
    echo "  GROVE_API_KEY      requires llm_env.GROVE_BASE_URL, optional GROVE_MODEL" >&2
    read -r -s -p "LLM API key: " key
    echo
    if aws secretsmanager describe-secret --secret-id "{{name}}" --region "{{region}}" >/dev/null 2>&1; then
      aws secretsmanager put-secret-value --secret-id "{{name}}" --secret-string "${key}" --region "{{region}}" >/dev/null
    else
      aws secretsmanager create-secret --name "{{name}}" --secret-string "${key}" --region "{{region}}" >/dev/null
    fi
    echo "{{name}}"

# Delete the LLM API key secret from Secrets Manager. Remove llm_secret_name from lz tfvars after.
delete-llm-secret name="hybrid-search-ui-llm" region="us-east-1":
    #!/usr/bin/env bash
    set -euo pipefail
    if ! aws secretsmanager describe-secret --secret-id "{{name}}" --region "{{region}}" >/dev/null 2>&1; then
      echo "Secret not found: {{name}}" >&2
      exit 1
    fi
    aws secretsmanager delete-secret --secret-id "{{name}}" --force-delete-without-recovery --region "{{region}}" >/dev/null
    echo "Deleted {{name}}"

# One-shot ECS RunTask of the live UI image: hybrid-search index create. Blocking until exit 0.
index-create:
    uv run python "{{justfile_directory()}}/scripts/index_create.py" "{{justfile_directory()}}/app"

# Download the AI-governance seed pack into a gitignored cache (no ingest).
seed-download:
    uv run python "{{seed_dir}}/download.py"

# Dump gitignored secrets/.env.local for docker-compose.local-ui.yml (needs public_debug_access).
dump-local-env region="" output="secrets/.env.local":
    #!/usr/bin/env bash
    set -euo pipefail
    script="{{justfile_directory()}}/scripts/dump_local_env.py"
    out="{{justfile_directory()}}/{{output}}"
    if [[ -n "{{region}}" ]]; then
      uv run python "${script}" --output "${out}" --region "{{region}}"
    else
      uv run python "${script}" --output "${out}"
    fi
    echo
    echo "Run the UI locally:"
    compose="{{justfile_directory()}}/docker/docker-compose.local-ui.yml"
    echo "  docker compose -f ${compose} --env-file ${out} up --build"
    echo
    echo "Open http://localhost:8001"
