# Update the placeholder values below with your values

# Atlas
atlas_org_id       = "<YOUR_ATLAS_ORG_ID>"
atlas_project_name = "<NAME_FOR_ATLAS_PROJECT>"
atlas_cluster_name = "<NAME_FOR_ATLAS_CLUSTER>"

# GCP
gcp_project_id = "<YOUR_GCP_PROJECT_ID>"

# Regions with PSC subnetwork self_links
# subnetwork must be a self_link, e.g. from google_compute_subnetwork.this.self_link
# or the full URL: https://www.googleapis.com/compute/v1/projects/<PROJECT>/regions/<REGION>/subnetworks/<NAME>
regions = [
  {
    name       = "<REGION>"
    subnetwork = "<YOUR_SUBNETWORK_SELF_LINK>"
  },
  {
    name       = "<REGION>"
    subnetwork = "<YOUR_SUBNETWORK_SELF_LINK>"
  }
]

# Validation VM (optional, enabled by default)
# Disable all validation resources:
# enable_validation_vm = false
#
# Override the automatically selected first sorted zone in the first region:
# validation_vm_zone = "us-east4-a"
#
# Override the default e2-micro machine type:
# validation_vm_machine_type = "e2-small"
#
# Disable creation of the targeted IAP SSH firewall rule when an equivalent rule exists:
# validation_vm_create_iap_ssh_firewall = false
#
# Create dedicated, subnet-scoped Cloud NAT only when the first subnet has no outbound internet access.
# Cloud NAT can incur charges and conflict with an existing NAT that already covers the subnet:
# validation_vm_enable_cloud_nat = true
